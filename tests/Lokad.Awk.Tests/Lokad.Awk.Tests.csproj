<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- The test-only entry point isolates process-fatal stack-safety probes. -->
    <OutputType>Exe</OutputType>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Lokad.Awk.Examples" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lokad.Awk\Lokad.Awk.csproj" />
    <PackageReference Include="Lokad.Utf8Regex" />
    <Compile Include="..\..\examples\Utf8RegexAdapter.cs" Link="Examples\Utf8RegexAdapter.cs" />
    <Compile Include="..\..\examples\MemoryHostPaths.cs" Link="Examples\MemoryHostPaths.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\verification\*.cs" Link="Verification\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
