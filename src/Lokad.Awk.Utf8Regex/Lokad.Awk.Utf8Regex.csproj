<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Lokad.Awk.Utf8Regex</PackageId>
    <Description>Optional UTF-8 regex engine adapter for Lokad.Awk.</Description>
    <Authors>Lokad</Authors>
    <Version>0.3.0</Version>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>../../artifacts/nuget/</PackageOutputPath>
    <RepositoryUrl>https://github.com/Lokad/Awk.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Lokad.Awk/Lokad.Awk.csproj" />
    <PackageReference Include="Lokad.Utf8Regex" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
